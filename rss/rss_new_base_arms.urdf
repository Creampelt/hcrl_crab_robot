  <material name="zimmer_silver">
    <color rgba="0.75 0.75 0.75 1" />
  </material>
  <material name="zimmer_black">
    <color rgba="0 0 0 1" />
  </material>
  <link name="ur20c_slide_ati_to_tombstone">
    <visual>
      <origin
          rpy="0 0 0"
          xyz="0 0 -0.0127" />
      <geometry>
        <cylinder
            length="0.0254"
            radius="0.095" />
      </geometry>
      <material name="Black(ish)">
        <color rgba="0.1216 0.1216 0.1216 1.0" />
      </material>
    </visual>
    <collision>
      <origin
          rpy="0 0 0"
          xyz="0 0 -0.0127" />
      <geometry>
        <cylinder
            length="0.0254"
            radius="0.095" />
      </geometry>
    </collision>
  </link>
  <joint
      name="ur20c_slide_ati_to_tombstone_joint"
      type="fixed">
    <origin
        rpy="0 0 -1.0472"
        xyz="0 0 0.0254" />
    <parent link="ur20c_slide_ati_ft_sensor" />
    <child link="ur20c_slide_ati_to_tombstone" />
  </joint>
  <link name="ur20c_slide_tombstone">
    <visual>
      <origin
          rpy="0 0 0"
          xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/rss_ur20/tombstone.stl" />
      </geometry>
      <material name="Black(ish)">
        <color rgba="0.1216 0.1216 0.1216 1.0" />
      </material>
    </visual>
    <collision>
      <origin
          rpy="0 0 0"
          xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/rss_ur20/tombstone.stl" />
      </geometry>
    </collision>
  </link>
  <joint
      name="ur20c_slide_tombstone_joint"
      type="fixed">
    <origin
        rpy="1.5708 0 3.14159"
        xyz="0 0.095 0.1352" />
    <parent link="ur20c_slide_ati_to_tombstone" />
    <child link="ur20c_slide_tombstone" />
  </joint>
  <!-- links -  main serial chain -->
  <!-- base_link serves as the root of the robot's kinematic tree. It follows REP-103
        conventions (i.e., X+ forward, Y+ left, Z+ up).
        Since some kinematic solvers forbid having inertia values attached to a root link, we've
        added the base_link_inertia link that carries the visual, collision and inertia
        information.
    -->
  <link name="ur20c_han_base_link" />
  <link name="ur20c_han_base_link_inertia">
    <visual>
      <origin
          rpy="0 0 3.141592653589793"
          xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/ur20/visual/base.dae" />
      </geometry>
    </visual>
    <collision>
      <origin
          rpy="0 0 3.141592653589793"
          xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/ur20/collision/base.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="4.0" />
      <origin
          rpy="0 0 0"
          xyz="0 0 0" />
      <inertia
          ixx="0.0061063308908"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0061063308908"
          iyz="0.0"
          izz="0.01125" />
    </inertial>
  </link>
  <link name="ur20c_han_shoulder_link">
    <visual>
      <origin
          rpy="0 0 3.141592653589793"
          xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/ur20/visual/shoulder.dae" />
      </geometry>
    </visual>
    <collision>
      <origin
          rpy="0 0 3.141592653589793"
          xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/ur20/collision/shoulder.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="16.343" />
      <origin
          rpy="1.570796326794897 0 0"
          xyz="0.0 -0.0062 -0.061" />
      <inertia
          ixx="0.08866"
          ixy="-0.00011"
          ixz="-0.00011"
          iyy="0.07632"
          iyz="0.0072"
          izz="0.08418" />
    </inertial>
  </link>
  <link name="ur20c_han_upper_arm_link">
    <visual>
      <origin
          rpy="1.5707963267948966 0 -1.5707963267948966"
          xyz="0 0 0.26" />
      <geometry>
        <mesh filename="meshes/ur20/visual/upperarm.dae" />
      </geometry>
    </visual>
    <collision>
      <origin
          rpy="1.5707963267948966 0 -1.5707963267948966"
          xyz="0 0 0.26" />
      <geometry>
        <mesh filename="meshes/ur20/collision/upperarm.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="29.632" />
      <origin
          rpy="0 0 0"
          xyz="-0.3394 0.0 0.2098" />
      <inertia
          ixx="0.1467"
          ixy="0.00019"
          ixz="-0.05163"
          iyy="4.6659"
          iyz="4e-05"
          izz="4.6348" />
    </inertial>
  </link>
  <link name="ur20c_han_forearm_link">
    <visual>
      <origin
          rpy="1.5707963267948966 0 -1.5707963267948966"
          xyz="0 0 0.043" />
      <geometry>
        <mesh filename="meshes/ur20/visual/forearm.dae" />
      </geometry>
    </visual>
    <collision>
      <origin
          rpy="1.5707963267948966 0 -1.5707963267948966"
          xyz="0 0 0.043" />
      <geometry>
        <mesh filename="meshes/ur20/collision/forearm.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="7.879" />
      <origin
          rpy="0 0 0"
          xyz="-0.4053 0.0 0.0604" />
      <inertia
          ixx="0.02612"
          ixy="-5e-05"
          ixz="-0.02898"
          iyy="0.75763"
          iyz="-1e-05"
          izz="0.75327" />
    </inertial>
  </link>
  <link name="ur20c_han_wrist_1_link">
    <visual>
      <origin
          rpy="1.5707963267948966 0 0"
          xyz="0 0 -0.0775" />
      <geometry>
        <mesh filename="meshes/ur20/visual/wrist1.dae" />
      </geometry>
    </visual>
    <collision>
      <origin
          rpy="1.5707963267948966 0 0"
          xyz="0 0 -0.0775" />
      <geometry>
        <mesh filename="meshes/ur20/collision/wrist1.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="3.054" />
      <origin
          rpy="1.570796326794897 0 0"
          xyz="0.0 -0.0393 -0.0026" />
      <inertia
          ixx="0.00555"
          ixy="-1e-05"
          ixz="-2e-05"
          iyy="0.00537"
          iyz="0.00036"
          izz="0.00402" />
    </inertial>
  </link>
  <link name="ur20c_han_wrist_2_link">
    <visual>
      <origin
          rpy="0 0 0"
          xyz="0 0 -0.0749" />
      <geometry>
        <mesh filename="meshes/ur20/visual/wrist2.dae" />
      </geometry>
    </visual>
    <collision>
      <origin
          rpy="0 0 0"
          xyz="0 0 -0.0749" />
      <geometry>
        <mesh filename="meshes/ur20/collision/wrist2.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="3.126" />
      <origin
          rpy="-1.570796326794897 0 0"
          xyz="0.0 0.0379 -0.0024" />
      <inertia
          ixx="0.00586"
          ixy="-1e-05"
          ixz="-2e-05"
          iyy="0.00578"
          iyz="-0.00037"
          izz="0.00427" />
    </inertial>
  </link>
  <link name="ur20c_han_wrist_3_link">
    <visual>
      <origin
          rpy="1.5707963267948966 0 0"
          xyz="0 0 -0.07" />
      <geometry>
        <mesh filename="meshes/ur20/visual/wrist3.dae" />
      </geometry>
    </visual>
    <collision>
      <origin
          rpy="1.5707963267948966 0 0"
          xyz="0 0 -0.07" />
      <geometry>
        <mesh filename="meshes/ur20/collision/wrist3.stl" />
      </geometry>
    </collision>
    <inertial>
      <mass value="0.926" />
      <origin
          rpy="0 0 0"
          xyz="0.0 0.0 -0.0293" />
      <inertia
          ixx="0.00092"
          ixy="0.0"
          ixz="0.0"
          iyy="0.00091"
          iyz="0.0"
          izz="0.00117" />
    </inertial>
  </link>
  <!-- base_joint fixes base_link to the environment -->
  <joint
      name="ur20c_han_base_joint"
      type="fixed">
    <origin
        rpy="0 0 0"
        xyz="0 0 0" />
    <parent link="ur20c_slide_tombstone" />
    <child link="ur20c_han_base_link" />
  </joint>
  <!-- joints - main serial chain -->
  <joint
      name="ur20c_han_base_link-base_link_inertia"
      type="fixed">
    <parent link="ur20c_han_base_link" />
    <child link="ur20c_han_base_link_inertia" />
    <!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
    <origin
        rpy="0 0 3.141592653589793"
        xyz="0 0 0" />
  </joint>
  <joint
      name="ur20c_han_shoulder_pan_joint"
      type="revolute">
    <parent link="ur20c_han_base_link_inertia" />
    <child link="ur20c_han_shoulder_link" />
    <origin
        rpy="0 0 1.0813043361136004e-07"
        xyz="0 0 0.23605804505849792" />
    <axis xyz="0 0 1" />
    <limit
        effort="738.0"
        lower="-6.283185307179586"
        upper="6.283185307179586"
        velocity="2.0943951023931953" />
    <dynamics
        damping="0"
        friction="0" />
  </joint>
  <joint
      name="ur20c_han_shoulder_lift_joint"
      type="revolute">
    <parent link="ur20c_han_shoulder_link" />
    <child link="ur20c_han_upper_arm_link" />
    <origin
        rpy="1.5708629459765144 0 -4.880508667138009e-06"
        xyz="9.754030555240492e-05 0 0" />
    <axis xyz="0 0 1" />
    <limit
        effort="738.0"
        lower="-6.283185307179586"
        upper="6.283185307179586"
        velocity="2.0943951023931953" />
    <dynamics
        damping="0"
        friction="0" />
  </joint>
  <joint
      name="ur20c_han_elbow_joint"
      type="revolute">
    <parent link="ur20c_han_upper_arm_link" />
    <child link="ur20c_han_forearm_link" />
    <origin
        rpy="0.0005884295412275638 -0.0004267141440094013 -7.335107699104623e-08"
        xyz="-0.8610921552590647 0 0" />
    <axis xyz="0 0 1" />
    <limit
        effort="433.0"
        lower="-3.141592653589793"
        upper="3.141592653589793"
        velocity="2.6179938779914944" />
    <dynamics
        damping="0"
        friction="0" />
  </joint>
  <joint
      name="ur20c_han_wrist_1_joint"
      type="revolute">
    <parent link="ur20c_han_forearm_link" />
    <child link="ur20c_han_wrist_1_link" />
    <origin
        rpy="3.1405048492789644 3.141195896656006 -3.1415923332207147"
        xyz="-0.7278670242516039 0.00021723008103170053 0.19969583976195102" />
    <axis xyz="0 0 1" />
    <limit
        effort="107.0"
        lower="-6.283185307179586"
        upper="6.283185307179586"
        velocity="3.6651914291880923" />
    <dynamics
        damping="0"
        friction="0" />
  </joint>
  <joint
      name="ur20c_han_wrist_2_joint"
      type="revolute">
    <parent link="ur20c_han_wrist_1_link" />
    <child link="ur20c_han_wrist_2_link" />
    <origin
        rpy="1.57136726958501 0 7.582584195860861e-08"
        xyz="-3.309974135769099e-05 -0.159114862392224 -9.084549335387157e-05" />
    <axis xyz="0 0 1" />
    <limit
        effort="107.0"
        lower="-6.283185307179586"
        upper="6.283185307179586"
        velocity="3.6651914291880923" />
    <dynamics
        damping="0"
        friction="0" />
  </joint>
  <joint
      name="ur20c_han_wrist_3_joint"
      type="revolute">
    <parent link="ur20c_han_wrist_2_link" />
    <child link="ur20c_han_wrist_3_link" />
    <origin
        rpy="1.5707691133726167 3.141592653589793 3.1415924379608358"
        xyz="-7.181658624943694e-05 0.1539659637667372 -4.189940789732904e-06" />
    <axis xyz="0 0 1" />
    <limit
        effort="107.0"
        lower="-6.283185307179586"
        upper="6.283185307179586"
        velocity="3.6651914291880923" />
    <dynamics
        damping="0"
        friction="0" />
  </joint>
  <link name="ur20c_han_ft_frame" />
  <joint
      name="ur20c_han_wrist_3_link-ft_frame"
      type="fixed">
    <parent link="ur20c_han_wrist_3_link" />
    <child link="ur20c_han_ft_frame" />
    <origin
        rpy="3.141592653589793 0 0"
        xyz="0 0 0" />
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="ur20c_han_base" />
  <joint
      name="ur20c_han_base_link-base_fixed_joint"
      type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin
        rpy="0 0 3.141592653589793"
        xyz="0 0 0" />
    <parent link="ur20c_han_base_link" />
    <child link="ur20c_han_base" />
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="ur20c_han_flange" />
  <joint
      name="ur20c_han_wrist_3-flange"
      type="fixed">
    <parent link="ur20c_han_wrist_3_link" />
    <child link="ur20c_han_flange" />
    <origin
        rpy="0 -1.5707963267948966 -1.5707963267948966"
        xyz="0 0 0" />
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="ur20c_han_tool0" />
  <joint
      name="ur20c_han_flange-tool0"
      type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin
        rpy="1.5707963267948966 0 1.5707963267948966"
        xyz="0 0 0" />
    <parent link="ur20c_han_flange" />
    <child link="ur20c_han_tool0" />
  </joint>
  <!-- Add URDF transmission elements (for ros_control) -->
  <!--<xacro:ur_arm_transmission
  prefix="${prefix}" hw_interface="${transmission_hw_interface}" />-->
  <!-- Placeholder for ros2_control transmission which don't yet exist -->
  <ros2_control
      name="han"
      type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
      <param name="mock_sensor_commands">True</param>
      <param name="state_following_offset">0.0</param>
      <param name="calculate_dynamics">true</param>
    </hardware>
    <joint name="ur20c_han_shoulder_pan_joint">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">1.57</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="ur20c_han_shoulder_lift_joint">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">1.57</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="ur20c_han_elbow_joint">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">-2.758</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="ur20c_han_wrist_1_joint">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">-0.733038</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="ur20c_han_wrist_2_joint">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">1.57</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <joint name="ur20c_han_wrist_3_joint">
      <command_interface name="position" />
      <command_interface name="velocity" />
      <state_interface name="position">
        <!-- initial position for the mock system and simulation -->
        <param name="initial_value">1.846021403280866e-20</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="effort">
        <param name="initial_value">0.0</param>
      </state_interface>
    </joint>
    <sensor name="han_tcp_fts_sensor">
      <state_interface name="force.x" />
      <state_interface name="force.y" />
      <state_interface name="force.z" />
      <state_interface name="torque.x" />
      <state_interface name="torque.y" />
      <state_interface name="torque.z" />
    </sensor>
    <sensor name="han_tcp_pose">
      <state_interface name="position.x" />
      <state_interface name="position.y" />
      <state_interface name="position.z" />
      <state_interface name="orientation.x" />
      <state_interface name="orientation.y" />
      <state_interface name="orientation.z" />
      <state_interface name="orientation.w" />
    </sensor>
    <!-- NOTE The following are joints used only for testing with mock hardware and will change in
    the future -->
    <gpio name="han_speed_scaling">
      <state_interface name="speed_scaling_factor">
        <param name="initial_value">1.0</param>
      </state_interface>
      <command_interface name="target_speed_fraction_cmd" />
      <command_interface name="target_speed_fraction_async_success" />
    </gpio>
    <gpio name="han_gpio">
      <command_interface name="standard_digital_output_cmd_0" />
      <command_interface name="standard_digital_output_cmd_1" />
      <command_interface name="standard_digital_output_cmd_2" />
      <command_interface name="standard_digital_output_cmd_3" />
      <command_interface name="standard_digital_output_cmd_4" />
      <command_interface name="standard_digital_output_cmd_5" />
      <command_interface name="standard_digital_output_cmd_6" />
      <command_interface name="standard_digital_output_cmd_7" />
      <command_interface name="standard_digital_output_cmd_8" />
      <command_interface name="standard_digital_output_cmd_9" />
      <command_interface name="standard_digital_output_cmd_10" />
      <command_interface name="standard_digital_output_cmd_11" />
      <command_interface name="standard_digital_output_cmd_12" />
      <command_interface name="standard_digital_output_cmd_13" />
      <command_interface name="standard_digital_output_cmd_14" />
      <command_interface name="standard_digital_output_cmd_15" />
      <command_interface name="standard_digital_output_cmd_16" />
      <command_interface name="standard_digital_output_cmd_17" />
      <command_interface name="standard_analog_output_cmd_0" />
      <command_interface name="standard_analog_output_cmd_1" />
      <command_interface name="analog_output_domain_cmd" />
      <command_interface name="tool_voltage_cmd" />
      <command_interface name="io_async_success" />
      <state_interface name="digital_output_0" />
      <state_interface name="digital_output_1" />
      <state_interface name="digital_output_2" />
      <state_interface name="digital_output_3" />
      <state_interface name="digital_output_4" />
      <state_interface name="digital_output_5" />
      <state_interface name="digital_output_6" />
      <state_interface name="digital_output_7" />
      <state_interface name="digital_output_8" />
      <state_interface name="digital_output_9" />
      <state_interface name="digital_output_10" />
      <state_interface name="digital_output_11" />
      <state_interface name="digital_output_12" />
      <state_interface name="digital_output_13" />
      <state_interface name="digital_output_14" />
      <state_interface name="digital_output_15" />
      <state_interface name="digital_output_16" />
      <state_interface name="digital_output_17" />
      <state_interface name="digital_input_0" />
      <state_interface name="digital_input_1" />
      <state_interface name="digital_input_2" />
      <state_interface name="digital_input_3" />
      <state_interface name="digital_input_4" />
      <state_interface name="digital_input_5" />
      <state_interface name="digital_input_6" />
      <state_interface name="digital_input_7" />
      <state_interface name="digital_input_8" />
