      <origin
          rpy="1.570796326794897 0 0"
          xyz="0.0 -0.0062 -0.061" />
      <inertia
          ixx="0.08866"
          ixy="-0.00011"
          ixz="-0.00011"
          iyy="0.07632"
          iyz="0.0072"
          izz="0.08418" />
    </inertial>
  </link>
  <link name="ur20b_han_upper_arm_link">
    <visual>
      <origin
          rpy="1.5707963267948966 0 -1.5707963267948966"
