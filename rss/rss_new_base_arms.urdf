      <origin
          rpy="0 0 0"
          xyz="0 0 0" />
      <inertia
          ixx="0.0061063308908"
          ixy="0.0"
          ixz="0.0"
          iyy="0.0061063308908"
          iyz="0.0"
          izz="0.01125" />
    </inertial>
  </link>
