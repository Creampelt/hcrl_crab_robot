    </visual>
    <collision>
      <origin
          rpy="0 0 3.141592653589793"
          xyz="0 0 0" />
      <geometry>
        <mesh filename="meshes/ur20/collision/shoulder.stl" />
      </geometry>
    </collision>
    <inertial>
